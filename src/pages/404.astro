---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
  <section class="min-h-[70vh] flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-gray-50 via-blue-50/30 to-white pointer-events-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-med-blue/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-72 h-72 bg-accent/5 rounded-full blur-3xl"></div>

    <div class="container-custom relative text-center py-16">
      <div class="max-w-md mx-auto">
        <p class="text-8xl font-display font-extrabold gradient-text mb-6">404</p>
        <h1 class="font-display text-2xl md:text-3xl font-bold text-dark mb-4">
          Page introuvable
        </h1>
        <p class="text-gray-500 text-lg mb-10 leading-relaxed">
          La page que vous recherchez n'existe pas ou a été déplacée. Pas d'inquiétude, nous allons vous remettre sur la bonne voie.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/" variant="primary" size="lg">
            Retour à l'accueil
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </Button>
          <Button href="/contact" variant="secondary">
            Nous contacter
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
